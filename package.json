{
  "name": "@yakult-green-tea/qq-music-api",
  "version": "3.0.0",
  "description": "非官方、社区维护的 QQ 音乐 API 服务，基于 Rain120/qq-music-api，支持原生扫码登录并可内嵌进 Docker 或 Electron 主进程。",
  "main": "dist/src/app.js",
  "types": "./types/root.d.ts",
  "exports": {
    ".": {
      "types": "./types/root.d.ts",
      "require": "./dist/src/app.js",
      "default": "./dist/src/app.js"
    },
    "./serverless": {
      "types": "./dist/src/serverless/index.d.ts",
      "import": "./dist-esm/src/serverless/index.js",
      "require": "./dist/src/serverless/index.js",
      "default": "./dist-esm/src/serverless/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-esm",
    "types",
    "LICENSE",
    "ATTRIBUTION.md",
    "README.md"
  ],
  "scripts": {
    "dev": "AUTO_OPEN_EXPLORER=true ts-node-dev --respawn --transpile-only src/app.ts",
    "start": "node -r ts-node/register/transpile-only src/app.ts",
    "start:dist": "node dist/src/app.js",
    "build": "tsc -p tsconfig.json --noEmit",
    "clean:dist": "node -e \"for (const d of ['dist','dist-esm']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "build:js": "npm run clean:dist && tsc -p tsconfig.build.json --outDir dist && npm run build:types && npm run build:esm && node scripts/prepare-runtime-assets.js",
    "docs": "docsify serve docs -p 9611",
    "commit-push": "./scripts/commit-push.sh",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "lint-staged": "lint-staged",
    "build:local-images": "node ./scripts/build-images.js local",
    "build:remote-images": "node ./scripts/build-images.js remote",
    "build:images": "npm run build:local-images && npm run build:remote-images",
    "run:images": "docker run -d --name qq-music-api -p 3200:3200 qq-music-api ",
    "probe:qq-login": "node scripts/probe-qq-native-qr-login.js",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "jest",
    "prepare": "husky && git config core.hooksPath .husky",
    "prepublishOnly": "npm run build:js",
    "build:esm": "tsc -p tsconfig.esm.json --outDir dist-esm && node scripts/finalize-esm-build.js",
    "build:types": "tsc -p tsconfig.types.json --outDir dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakult-green-tea/qq-music-api.git"
  },
  "keywords": [
    "QQ音乐",
    "音乐",
    "QQ音乐koa2"
  ],
  "author": "Rain120",
  "contributors": [
    "yakult-green-tea",
    "chthollyphile"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yakult-green-tea/qq-music-api/issues"
  },
  "homepage": "https://github.com/yakult-green-tea/qq-music-api#readme",
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "chalk": "^4.1.0",
    "colors": "^1.3.3",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.2.1",
    "koa-router": "^7.4.0",
    "koa-static": "^5.0.0",
    "lodash.get": "^4.4.2",
    "moment": "^2.24.0",
    "ws": "^7.5.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.2",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-router": "^7.4.9",
    "@types/koa-static": "^4.0.4",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "conventional-changelog-cli": "^5.0.0",
    "docsify-cli": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^10.5.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
